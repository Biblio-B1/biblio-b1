# Code secret permettant de créer le premier compte administrateur
ADMIN_INVITE_CODE=change-me
# Dépôt GitHub des cours du professeur
C_PROF_REPO_URL=https://github.com/S-L-A-K-E-R/C_courses
PORT=3000
# Dossier de stockage (base SQLite, uploads, clone du dépôt)
STORAGE_PATH=./storage
# Dossier local de cours importé par `npm run import` : chaque sous-dossier = une matière
# (ex. Windows : C:/Users/moi/Desktop/cours). Lu seulement, jamais modifié.
LOCAL_COURSES_PATH=./sources/local
# Chaîne aléatoire longue (ex. : openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string
# Cookie de session « Secure » : laisser false en HTTP (réseau local), mettre true derrière HTTPS
COOKIE_SECURE=false
