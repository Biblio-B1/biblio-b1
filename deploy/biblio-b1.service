# Unité systemd « utilisateur » pour Biblio B1.
# Installation :
#   mkdir -p ~/.config/systemd/user
#   cp deploy/biblio-b1.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now biblio-b1
#   loginctl enable-linger "$USER"     # démarre aussi sans session ouverte
# Adaptez WorkingDirectory si le dépôt n'est pas dans ~/biblio-b1.
# La configuration (PORT, ADMIN_INVITE_CODE, APP_URL, …) est lue dans le fichier .env du dossier de travail.
[Unit]
Description=Biblio B1 (bibliothèque d'étude de la promo)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/biblio-b1
Environment=NODE_ENV=production
# Aucun signal ne peut ouvrir l'inspecteur V8 (défense en profondeur, bac à sable du solveur).
Environment=NODE_OPTIONS=--disable-sigusr1
# Node installé avec nvm : `npm` n'est pas dans le PATH de systemd et ~/.bashrc n'est pas lu en
# shell non interactif, d'où le chargement de nvm.sh… seulement s'il existe : sans nvm (paquet apt,
# NodeSource), node et npm viennent du PATH. Le code de retour de nvm est ignoré (il peut être non nul
# sans empêcher node de fonctionner) : seul l'échec de `npm start` compte.
ExecStart=/bin/bash -c 'if [ -s "$HOME/.nvm/nvm.sh" ]; then . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1; nvm use --silent default >/dev/null 2>&1; fi; exec npm start'
Restart=on-failure
RestartSec=5
# 143 = 128 + SIGTERM : un arrêt via `systemctl stop` n'est pas compté comme un échec.
# Une configuration refusée (.env) fait sortir en code 1 : l'unité passe en « failed ».
SuccessExitStatus=143

[Install]
WantedBy=default.target
